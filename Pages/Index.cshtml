@page
@model IndexModel
@{
    ViewData["Title"] = "Smart recycling, made simple";
}

<section class="landing-hero">
    <div class="landing-hero__copy">
        <span class="landing-eyebrow">♻ Recycling Management System</span>
        <h1>Smart Waste Tracking,<br />Beautiful Environmental Impact.</h1>
        <p>Scan waste instantly to identify recyclables, schedule door-to-door pickups, earn reward points, and track your true circular contribution today.</p>
        <div class="reloop-action-row">
            <a class="reloop-btn reloop-btn--primary" asp-page="/SignUp">Get Started Free <span aria-hidden="true">→</span></a>
            <a class="reloop-btn reloop-btn--secondary" href="#how-it-works">Learn More</a>
        </div>
    </div>
    <div class="landing-hero__visual" role="img" aria-label="Clean recycling collection table with glass and plastic containers">
        <div class="landing-visual__sun"></div><div class="landing-visual__window"></div>
        <div class="landing-visual__shelf"><span></span><span></span><span></span><span></span><span></span></div>
        <div class="landing-visual__plant">◒</div><div class="landing-visual__table"></div>
        <div class="landing-visual__caption">A cleaner loop starts with one scan.</div>
    </div>
</section>

<section class="landing-stats" aria-label="ReLoop impact statistics">
    <div><strong>1.2M+</strong><span>Items Properly Recycled</span></div><div><strong>45,000 kg</strong><span>Landfill Waste Diverted</span></div>
    <div><strong>15,000+</strong><span>Active Circular Citizens</span></div><div><strong>120k+</strong><span>Eco Reward Points Issued</span></div>
</section>

<section class="landing-section landing-section--muted">
    <div class="landing-heading"><span class="landing-eyebrow">The ReLoop difference</span><h2>Designed for Simplicity and Impact</h2><p>An ecosystem built to make recycling secondary nature, providing you with real-time feedback and incentives.</p></div>
    <div class="landing-features">
        <article class="landing-feature"><div class="landing-feature__icon landing-feature__icon--green">⌾</div><h3>Scan &amp; Identify</h3><p>Point your camera at any waste item. Our AI instantly classifies it as recyclable, organic, glass, or landfill.</p></article>
        <article class="landing-feature"><div class="landing-feature__icon landing-feature__icon--blue">▣</div><h3>Schedule Pickups</h3><p>Book a convenient collection slot in seconds. Local collectors arrive right at your doorstep.</p></article>
        <article class="landing-feature"><div class="landing-feature__icon landing-feature__icon--orange">✦</div><h3>Earn Reward Points</h3><p>Recycle verified items to rack up eco-points. Redeem them for gift cards, partner discounts, or tree planting.</p></article>
        <article class="landing-feature"><div class="landing-feature__icon landing-feature__icon--pink">☆</div><h3>Track Circular Progress</h3><p>View comprehensive dashboard analytics detailing your carbon footprint mitigation and circular metrics.</p></article>
    </div>
</section>

<section class="landing-section" id="how-it-works">
    <div class="landing-heading"><span class="landing-eyebrow">Your everyday loop</span><h2>How ReLoop Works</h2><p>Three simple steps to transition from wasteful disposal to premium smart circularity.</p></div>
    <div class="landing-steps">
        <article><strong>01</strong><h3>Capture or Scan</h3><p>Scan the waste object via the ReLoop app to automatically log classification and verify standard weight.</p></article>
        <article><strong>02</strong><h3>Schedule Pickup</h3><p>Consolidate items and book a pickup date. Our local eco-partners handle transport directly.</p></article>
        <article><strong>03</strong><h3>Claim Rewards</h3><p>Receive instant points as soon as materials are verified at local processing centers.</p></article>
    </div>
</section>
