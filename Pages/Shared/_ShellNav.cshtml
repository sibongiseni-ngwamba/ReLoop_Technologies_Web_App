@{
    var currentPage = (ViewContext.RouteData.Values["page"] as string ?? string.Empty).Trim();

    bool IsCurrent(string page) =>
        string.Equals(currentPage, page, StringComparison.OrdinalIgnoreCase);
}

<nav class="reloop-nav" id="primary-navigation" aria-label="Primary">
    <a class="reloop-nav__link @(IsCurrent("/Index") ? "is-active" : string.Empty)" asp-page="/Index">Home</a>
    <a class="reloop-nav__link @(IsCurrent("/About") ? "is-active" : string.Empty)" asp-page="/About">About</a>
    <a class="reloop-nav__link @(IsCurrent("/Services") ? "is-active" : string.Empty)" asp-page="/Services">Services</a>
    <a class="reloop-nav__link @(IsCurrent("/Recycling") ? "is-active" : string.Empty)" asp-page="/Recycling">Recycling guide</a>
    <a class="reloop-nav__link @(IsCurrent("/Contact") ? "is-active" : string.Empty)" asp-page="/Contact">Contact</a>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <a class="reloop-nav__link @(IsCurrent("/Dashboard") ? "is-active" : string.Empty)" asp-page="/Dashboard">My dashboard</a>
        <a class="reloop-nav__link @(IsCurrent("/ScanWaste") ? "is-active" : string.Empty)" asp-page="/ScanWaste">Scan waste</a>
        <a class="reloop-nav__link @(IsCurrent("/SchedulePickup") ? "is-active" : string.Empty)" asp-page="/SchedulePickup">Schedule pickup</a>
        <a class="reloop-nav__link @(IsCurrent("/MyPickups") ? "is-active" : string.Empty)" asp-page="/MyPickups">My pickups</a>
        @if (User.IsInRole("Admin"))
        {
            <a class="reloop-nav__link @(IsCurrent("/Admin/Index") ? "is-active" : string.Empty)" asp-page="/Admin/Index">Admin</a>
        }
    }
</nav>
