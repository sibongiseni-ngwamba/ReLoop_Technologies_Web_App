@{
    var currentPage = (ViewContext.RouteData.Values["page"] as string ?? string.Empty).Trim();

    bool IsCurrent(string page) =>
        string.Equals(currentPage, page, StringComparison.OrdinalIgnoreCase);
}

<nav class="reloop-nav" aria-label="Primary">
    <a class="reloop-nav__link @(IsCurrent("/Index") ? "is-active" : string.Empty)" asp-page="/Index">Home</a>
    <a data-auth-nav data-roles="resident,agent,admin" class="reloop-nav__link @(IsCurrent("/Dashboard") ? "is-active" : string.Empty)" asp-page="/Dashboard" hidden>Dashboard</a>
    <a data-auth-nav data-roles="resident,admin" class="reloop-nav__link @(IsCurrent("/ScanWaste") ? "is-active" : string.Empty)" asp-page="/ScanWaste" hidden>Scan waste</a>
    <a data-auth-nav data-roles="resident,admin" class="reloop-nav__link @(IsCurrent("/SchedulePickup") ? "is-active" : string.Empty)" asp-page="/SchedulePickup" hidden>Schedule Pickup</a>
    <a data-auth-nav data-roles="resident,agent" class="reloop-nav__link @(IsCurrent("/MyPickups") ? "is-active" : string.Empty)" asp-page="/MyPickups" hidden>My Pickups</a>
    <a class="reloop-nav__link @(IsCurrent("/About") ? "is-active" : string.Empty)" asp-page="/About">About</a>
    <a class="reloop-nav__link @(IsCurrent("/Contact") ? "is-active" : string.Empty)" asp-page="/Contact">Contact</a>
    <a data-admin-nav class="reloop-nav__link @(IsCurrent("/Admin/Index") ? "is-active" : string.Empty)" asp-page="/Admin/Index" hidden>Admin</a>
</nav>
