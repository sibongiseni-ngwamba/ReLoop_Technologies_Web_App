<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] is string pageTitle && !string.IsNullOrWhiteSpace(pageTitle) ? $"{pageTitle} · ReLoop" : "ReLoop")</title>
    <meta name="theme-color" content="#16A34A" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ReLoop_Technologies_Web_App.styles.css" asp-append-version="true" />
</head>
<body class="reloop-shell">
    <div class="reloop-shell__backdrop" aria-hidden="true"></div>

    <header class="reloop-topbar">
        <div class="reloop-container reloop-topbar__inner">
            <a class="brand-lockup" asp-page="/Index" aria-label="ReLoop home">
                <span class="brand-lockup__mark" aria-hidden="true">
                    <svg viewBox="0 0 48 48" focusable="false" role="img">
                        <defs>
                            <linearGradient id="reloopMarkGradient" x1="0%" y1="0%" x2="100%" y2="100%">
                                <stop offset="0%" stop-color="#0f7a35" />
                                <stop offset="100%" stop-color="#7ed957" />
                            </linearGradient>
                        </defs>
                        <path d="M16 11c-7 0-13 5.7-13 13s6 13 13 13c5.2 0 9.8-3 11.8-7.4l2.2-4.6 2.2 4.6C34.2 34 38.8 37 44 37c7 0 13-5.7 13-13s-6-13-13-13c-5.2 0-9.8 3-11.8 7.4L30 22l-2.2-4.6C25.8 14 21.2 11 16 11Z" fill="none" stroke="url(#reloopMarkGradient)" stroke-width="3.6" stroke-linecap="round" stroke-linejoin="round" transform="translate(-3 -1.5) scale(.72)" />
                    </svg>
                </span>
                <span class="brand-lockup__copy">
                    <span class="brand-lockup__name">ReLoop</span>
                    <span class="brand-lockup__tag">Recycling Management System</span>
                </span>
            </a>

            <partial name="_ShellNav" />

            <div class="reloop-topbar__actions">
                <a class="reloop-icon-button" asp-page="/Dashboard" aria-label="Notifications">
                    <span aria-hidden="true">🔔</span>
                </a>
                <a class="reloop-avatar" asp-page="/Profile" aria-label="User profile">A</a>
                <a class="reloop-btn reloop-btn--secondary reloop-topbar__login" asp-page="/Login">Login</a>
            </div>
        </div>
    </header>

    <main class="reloop-main">
        <div class="reloop-container">
            @RenderBody()
        </div>
    </main>

    <footer class="reloop-footer">
        <div class="reloop-container reloop-footer__inner">
            <div class="reloop-footer__brand">
                <a class="brand-lockup brand-lockup--footer" asp-page="/Index" aria-label="ReLoop home">
                    <span class="brand-lockup__mark" aria-hidden="true">
                        <svg viewBox="0 0 48 48" focusable="false" role="img">
                            <defs>
                                <linearGradient id="reloopMarkGradientFooter" x1="0%" y1="0%" x2="100%" y2="100%">
                                    <stop offset="0%" stop-color="#0f7a35" />
                                    <stop offset="100%" stop-color="#7ed957" />
                                </linearGradient>
                            </defs>
                            <path d="M16 11c-7 0-13 5.7-13 13s6 13 13 13c5.2 0 9.8-3 11.8-7.4l2.2-4.6 2.2 4.6C34.2 34 38.8 37 44 37c7 0 13-5.7 13-13s-6-13-13-13c-5.2 0-9.8 3-11.8 7.4L30 22l-2.2-4.6C25.8 14 21.2 11 16 11Z" fill="none" stroke="url(#reloopMarkGradientFooter)" stroke-width="3.6" stroke-linecap="round" stroke-linejoin="round" transform="translate(-3 -1.5) scale(.72)" />
                        </svg>
                    </span>
                    <span class="brand-lockup__copy">
                        <span class="brand-lockup__name">ReLoop</span>
                        <span class="brand-lockup__tag">Circularity platform</span>
                    </span>
                </a>
                <p class="reloop-footer__copy">
                    Making circular recycling easier to scan, schedule, verify, and reward.
                </p>
            </div>

            <div class="reloop-footer__links">
                <div>
                    <h2>Platform</h2>
                    <a asp-page="/Index">Home</a>
                    <a asp-page="/Dashboard">Dashboard</a>
                    <a asp-page="/ScanWaste">Scan Waste</a>
                    <a asp-page="/SchedulePickup">Schedule Pickup</a>
                </div>
                <div>
                    <h2>Company</h2>
                    <a asp-page="/About">About</a>
                    <a asp-page="/Contact">Contact</a>
                    <a asp-page="/Privacy">Privacy</a>
                </div>
                <div>
                    <h2>Account</h2>
                    <a asp-page="/Profile">Profile</a>
                    <a asp-page="/MyPickups">My Pickups</a>
                    <a asp-page="/Logout">Logout</a>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
