@page
@{
    ViewData["Title"] = "Admin Console";
}

<section class="app-page admin-page js-admin-management">
    <div class="admin-layout">
        <aside class="admin-sidebar">
            <strong>Admin Panel</strong>
            <a class="is-active" asp-page="/Admin/Index">Overview</a>
            <a asp-page="/Profile">User profile</a>
            <a asp-page="/MyPickups">Active pickups</a>
            <a asp-page="/Recycling">Environmental guide</a>
            <a asp-page="/Contact">Partner support</a>
        </aside>

        <div class="admin-workspace">
            <div class="page-heading" id="overview">
                <p class="landing-eyebrow">Authorised workspace</p>
                <h1>Operations dashboard</h1>
                <p>Manage members, collection operations, recycling activity, and circular rewards from current system data.</p>
            </div>

            <div class="metric-grid" data-admin-metrics aria-live="polite"><p class="empty-state">Loading admin statistics…</p></div>

            <div class="content-grid">
                <section class="panel">
                    <h2>Waste Distribution by Type</h2>
                    <div class="donut" aria-label="Waste distribution chart"><span>1.87 Tons</span></div>
                    <div class="legend" data-admin-legend aria-live="polite"><p class="empty-state">Loading material breakdown…</p></div>
                </section>
                <section class="panel table-panel">
                    <h2>Recent pickups pending verification</h2>
                    <table class="app-table">
                        <thead><tr><th>User</th><th>Date Logged</th><th>Type</th><th>Est. Weight</th><th>Status</th></tr></thead>
                        <tbody data-admin-table><tr><td colspan="5" class="empty-state">Loading pickup records…</td></tr></tbody>
                    </table>
                </section>
            </div>
        </div>
    </div>
</section>

<dialog class="admin-dialog" data-admin-dialog><form method="dialog" data-admin-editor><div data-admin-editor-fields></div><div class="button-pair"><button class="reloop-btn reloop-btn--primary" type="submit">Save changes</button><button class="reloop-btn reloop-btn--secondary" type="button" data-admin-cancel>Cancel</button></div><p class="form-status" data-admin-editor-status aria-live="polite"></p></form></dialog>
