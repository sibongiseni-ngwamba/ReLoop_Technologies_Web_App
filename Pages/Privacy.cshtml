@page
@model PrivacyModel
@{
    ViewData["Title"] = "Privacy Policy";
}
<section class="app-page legal-page">
    <div class="page-heading"><p class="landing-eyebrow">Privacy</p><h1>Your recycling data, handled with care.</h1><p>We use your account and collection details to provide ReLoop services and maintain your verified impact history.</p></div>
    <div class="panel legal-copy">
        <h2>What we collect</h2><p>We collect the details you provide when creating an account, scheduling a pickup, submitting a contact request, or using a waste scan.</p>
        <h2>How we use it</h2><p>Information is used to deliver collection services, keep your recycling ledger accurate, respond to support requests, and improve the platform.</p>
        <h2>Your choices</h2><p>You can update profile details at any time. For questions about your data, contact us through the support form.</p>
        <a class="reloop-btn reloop-btn--secondary" asp-page="/Contact">Contact support</a>
    </div>
</section>
